{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "outDir": "build",
    "rootDir": "./src",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules, env, build"]
}